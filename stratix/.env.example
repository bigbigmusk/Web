# ──────────────────────────────────────────────────────────────
# STRATIX — Environment Variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs fully in MOCK MODE when these are absent, so you can
# explore every feature without any external accounts.
# ──────────────────────────────────────────────────────────────

# Supabase (auth + database). Leave blank to use the local mock auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for privileged operations (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible AI provider. Leave blank to use deterministic mock AI.
# Works with OpenAI, Azure OpenAI, OpenRouter, DeepSeek, Moonshot, etc.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set to "true" once AI_API_KEY is configured, so the UI badges "AI Live".
NEXT_PUBLIC_AI_ENABLED=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
